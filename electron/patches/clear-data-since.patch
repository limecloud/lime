+v8::Local<v8::Value> Session::ClearDataSince(gin::Arguments* const args) {
+  v8::Isolate* const isolate = JavascriptEnvironment::GetIsolate();
+  v8::Local<v8::Value> since_value;
+  if (!args->GetNext(&since_value) || !since_value->IsNumber()) {
+    args->ThrowTypeError(
+        "since must be a non-negative integer Unix millisecond timestamp");
+    return v8::Undefined(isolate);
+  }
+
+  const double since = since_value.As<v8::Number>()->Value();
+  if (!std::isfinite(since) || since < 0 || std::trunc(since) != since) {
+    args->ThrowTypeError(
+        "since must be a non-negative integer Unix millisecond timestamp");
+    return v8::Undefined(isolate);
+  }
+
+  const base::Time delete_begin =
+      base::Time::FromMillisecondsSinceUnixEpoch(since);
+  if (delete_begin.InMillisecondsFSinceUnixEpochIgnoringNull() != since) {
+    args->ThrowTypeError("since is outside the supported native time range");
+    return v8::Undefined(isolate);
+  }
+  return ClearDataImpl(args, delete_begin, true);
+}
