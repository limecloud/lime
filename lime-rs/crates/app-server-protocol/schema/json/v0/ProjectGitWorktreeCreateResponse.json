{
  "$defs": {
    "LocalEnvironmentScriptResult": {
      "properties": {
        "cwd": {
          "type": "string"
        },
        "error": {
          "type": [
            "null",
            "string"
          ]
        },
        "finishedAt": {
          "format": "int64",
          "type": "integer"
        },
        "log": {
          "type": "string"
        },
        "scriptPath": {
          "type": "string"
        },
        "startedAt": {
          "format": "int64",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/LocalEnvironmentScriptStatus"
        }
      },
      "required": [
        "cwd",
        "finishedAt",
        "log",
        "scriptPath",
        "startedAt",
        "status"
      ],
      "type": "object"
    },
    "LocalEnvironmentScriptStatus": {
      "enum": [
        "failed",
        "succeeded"
      ],
      "type": "string"
    },
    "ProjectGitStatusResponse": {
      "properties": {
        "branches": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "currentBranch": {
          "type": [
            "null",
            "string"
          ]
        },
        "hasGitRepository": {
          "type": "boolean"
        },
        "isWorktree": {
          "default": false,
          "type": "boolean"
        },
        "localEnvironmentConfigPath": {
          "type": [
            "null",
            "string"
          ]
        },
        "repositoryRoot": {
          "type": [
            "null",
            "string"
          ]
        },
        "rootPath": {
          "type": "string"
        },
        "uncommittedFileCount": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "hasGitRepository",
        "rootPath"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "branch": {
      "type": "string"
    },
    "setupError": {
      "type": [
        "null",
        "string"
      ]
    },
    "setupResult": {
      "anyOf": [
        {
          "$ref": "#/$defs/LocalEnvironmentScriptResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "$ref": "#/$defs/ProjectGitStatusResponse"
    },
    "worktreePath": {
      "type": "string"
    }
  },
  "required": [
    "branch",
    "status",
    "worktreePath"
  ],
  "title": "ProjectGitWorktreeCreateResponse",
  "type": "object"
}
