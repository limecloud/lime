{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "短时 OpenAI Realtime client secret 与浏览器 SDP endpoint。\n\n`clientSecret` 是 `ek_...` 短时凭证，只用于 renderer 直接发起 WebRTC SDP\n交换；它不包含标准 API key。字段的 Debug 输出会隐藏 secret。",
  "properties": {
    "callsUrl": {
      "type": "string"
    },
    "clientSecret": {
      "type": "string"
    },
    "expiresAt": {
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "model": {
      "type": "string"
    },
    "providerId": {
      "type": "string"
    },
    "voice": {
      "type": "string"
    }
  },
  "required": [
    "callsUrl",
    "clientSecret",
    "model",
    "providerId",
    "voice"
  ],
  "title": "VoiceRealtimeClientSecretResponse",
  "type": "object"
}
