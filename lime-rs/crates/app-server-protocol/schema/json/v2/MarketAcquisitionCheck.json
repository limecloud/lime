{
  "$defs": {
    "MarketAcquisitionStatus": {
      "description": "Only the acquisition is checked; publication and runtime approval are separate.",
      "enum": [
        "active",
        "revoked",
        "unavailable"
      ],
      "type": "string"
    },
    "MarketReleaseReference": {
      "additionalProperties": false,
      "description": "Immutable artifact identity, independent of the item's current publication.",
      "properties": {
        "archiveSha256": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "manifestSha256": {
          "type": "string"
        }
      },
      "required": [
        "archiveSha256",
        "id",
        "manifestSha256"
      ],
      "type": "object"
    },
    "MarketResourceKind": {
      "enum": [
        "mcp",
        "skill"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "acquisitionStatus": {
      "$ref": "#/$defs/MarketAcquisitionStatus"
    },
    "itemId": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/MarketResourceKind"
    },
    "release": {
      "$ref": "#/$defs/MarketReleaseReference"
    }
  },
  "required": [
    "acquisitionStatus",
    "itemId",
    "kind",
    "release"
  ],
  "title": "MarketAcquisitionCheck",
  "type": "object"
}
