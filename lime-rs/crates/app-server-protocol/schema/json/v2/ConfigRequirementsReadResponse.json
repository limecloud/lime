{
  "$defs": {
    "AllowDenyRequirement": {
      "enum": [
        "allow",
        "deny"
      ],
      "type": "string"
    },
    "ApplicationNetworkRequirements": {
      "properties": {
        "domains": {
          "additionalProperties": {
            "$ref": "#/$defs/NetworkDomainPermission"
          },
          "type": "object"
        },
        "enabled": {
          "description": "When enabled, only explicitly allowed exact domains may be contacted.",
          "type": "boolean"
        }
      },
      "required": [
        "domains",
        "enabled"
      ],
      "type": "object"
    },
    "ApplicationRequirements": {
      "properties": {
        "network": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApplicationNetworkRequirements"
            },
            {
              "type": "null"
            }
          ]
        },
        "storage": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApplicationStorageRequirements"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "ApplicationStorageRequirements": {
      "description": "Managed storage settings for new Desktop workspaces, not filesystem access restrictions.",
      "properties": {
        "defaultProjectParent": {
          "type": [
            "null",
            "string"
          ]
        },
        "projectlessWorkspaceRoot": {
          "type": [
            "null",
            "string"
          ]
        }
      },
      "type": "object"
    },
    "BrowserUseAccessApprovalLifetime": {
      "enum": [
        "thread",
        "turn"
      ],
      "type": "string"
    },
    "BrowserUseExtensionRequirements": {
      "properties": {
        "requestHeaders": {
          "items": {
            "$ref": "#/$defs/RequestHeader"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "BrowserUseOriginPolicy": {
      "properties": {
        "access": {
          "anyOf": [
            {
              "$ref": "#/$defs/AllowDenyRequirement"
            },
            {
              "type": "null"
            }
          ]
        },
        "accessApprovalLifetime": {
          "anyOf": [
            {
              "$ref": "#/$defs/BrowserUseAccessApprovalLifetime"
            },
            {
              "type": "null"
            }
          ]
        },
        "autoReview": {
          "anyOf": [
            {
              "$ref": "#/$defs/AllowDenyRequirement"
            },
            {
              "type": "null"
            }
          ]
        },
        "downloads": {
          "anyOf": [
            {
              "$ref": "#/$defs/AllowDenyRequirement"
            },
            {
              "type": "null"
            }
          ]
        },
        "fullCdpAccess": {
          "anyOf": [
            {
              "$ref": "#/$defs/AllowDenyRequirement"
            },
            {
              "type": "null"
            }
          ]
        },
        "persistentApproval": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "uploads": {
          "anyOf": [
            {
              "$ref": "#/$defs/AllowDenyRequirement"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "BrowserUseRequirements": {
      "properties": {
        "allowGlobalPersistentApproval": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "allowHistoryAccess": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "allowWebmcp": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "defaultOriginPolicy": {
          "anyOf": [
            {
              "$ref": "#/$defs/BrowserUseOriginPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "disableAutoReview": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "extension": {
          "anyOf": [
            {
              "$ref": "#/$defs/BrowserUseExtensionRequirements"
            },
            {
              "type": "null"
            }
          ]
        },
        "origins": {
          "additionalProperties": {
            "$ref": "#/$defs/BrowserUseOriginPolicy"
          },
          "type": [
            "null",
            "object"
          ]
        }
      },
      "type": "object"
    },
    "ComputerUseMacosRequirements": {
      "properties": {
        "bundleIds": {
          "additionalProperties": {
            "$ref": "#/$defs/AllowDenyRequirement"
          },
          "type": [
            "null",
            "object"
          ]
        }
      },
      "type": "object"
    },
    "ComputerUseRequirements": {
      "properties": {
        "allowLockedComputerUse": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "allowPersistentApproval": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "defaultAppAccess": {
          "anyOf": [
            {
              "$ref": "#/$defs/AllowDenyRequirement"
            },
            {
              "type": "null"
            }
          ]
        },
        "macos": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComputerUseMacosRequirements"
            },
            {
              "type": "null"
            }
          ]
        },
        "windows": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComputerUseWindowsRequirements"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "ComputerUseWindowsExeRequirement": {
      "properties": {
        "access": {
          "$ref": "#/$defs/AllowDenyRequirement"
        },
        "binaryName": {
          "type": [
            "null",
            "string"
          ]
        },
        "productName": {
          "type": "string"
        },
        "publisherName": {
          "type": "string"
        }
      },
      "required": [
        "access",
        "productName",
        "publisherName"
      ],
      "type": "object"
    },
    "ComputerUseWindowsRequirements": {
      "properties": {
        "aumids": {
          "additionalProperties": {
            "$ref": "#/$defs/AllowDenyRequirement"
          },
          "type": [
            "null",
            "object"
          ]
        },
        "exes": {
          "items": {
            "$ref": "#/$defs/ComputerUseWindowsExeRequirement"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ConfigRequirements": {
      "description": "Read-only constraints from the administrator policy source.",
      "properties": {
        "allowBrowserAndComputerUse": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "allowedApprovalPolicies": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "allowedSandboxModes": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "allowedWebSearchModes": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "application": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApplicationRequirements"
            },
            {
              "type": "null"
            }
          ]
        },
        "browserUse": {
          "anyOf": [
            {
              "$ref": "#/$defs/BrowserUseRequirements"
            },
            {
              "type": "null"
            }
          ]
        },
        "computerUse": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComputerUseRequirements"
            },
            {
              "type": "null"
            }
          ]
        },
        "inAppBrowser": {
          "anyOf": [
            {
              "$ref": "#/$defs/InAppBrowserRequirements"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "InAppBrowserRequirements": {
      "properties": {
        "allowExternalBrowserSettingsImport": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "NetworkDomainPermission": {
      "enum": [
        "allow",
        "deny"
      ],
      "type": "string"
    },
    "RequestHeader": {
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "requirements": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConfigRequirements"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "title": "ConfigRequirementsReadResponse",
  "type": "object"
}
