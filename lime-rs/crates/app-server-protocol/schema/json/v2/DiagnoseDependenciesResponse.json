{
  "$defs": {
    "PrimaryRuntimeInstallPhase": {
      "enum": [
        "canceled",
        "configuring",
        "downloading",
        "error",
        "extracting",
        "ready",
        "validating",
        "verifying"
      ],
      "type": "string"
    },
    "PrimaryRuntimeInstallProgress": {
      "properties": {
        "downloadedBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "error": {
          "type": [
            "null",
            "string"
          ]
        },
        "id": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/PrimaryRuntimeInstallPhase"
        },
        "totalBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "downloadedBytes",
        "id",
        "phase"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "bundleVersion": {
      "type": [
        "null",
        "string"
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "expectedVersion": {
      "type": "string"
    },
    "installed": {
      "type": "boolean"
    },
    "problems": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "supported": {
      "type": "boolean"
    },
    "update": {
      "anyOf": [
        {
          "$ref": "#/$defs/PrimaryRuntimeInstallProgress"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "enabled",
    "expectedVersion",
    "installed",
    "problems",
    "supported"
  ],
  "title": "DiagnoseDependenciesResponse",
  "type": "object"
}
