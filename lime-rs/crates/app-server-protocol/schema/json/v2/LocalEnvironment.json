            {
              "$ref": "#/$defs/LocalEnvironmentScript"
            },
            {
              "type": "null"
            }
          ]
        },
        "script": {
          "type": "string"
        },
        "win32": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalEnvironmentScript"
            },
            {
              "type": "null"
            }
          ]
