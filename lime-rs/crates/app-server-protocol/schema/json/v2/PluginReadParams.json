{
  "$defs": {
    "MarketReleaseReference": {
      "additionalProperties": false,
      "description": "Immutable artifact identity, independent of the item's current publication.",
      "properties": {
        "archiveSha256": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "manifestSha256": {
          "type": "string"
        }
      },
      "required": [
        "archiveSha256",
        "id",
        "manifestSha256"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "marketplacePath": {
      "type": [
        "null",
        "string"
      ]
    },
    "pluginName": {
      "type": "string"
    },
    "remoteMarketplaceName": {
      "type": [
        "null",
        "string"
      ]
    },
    "remoteRelease": {
      "anyOf": [
        {
          "$ref": "#/$defs/MarketReleaseReference"
        },
        {
          "type": "null"
        }
      ],
      "description": "Exact catalog release. Omit to read an installed plugin."
    }
  },
  "required": [
    "pluginName"
  ],
  "title": "PluginReadParams",
  "type": "object"
}
