{
  "$defs": {
    "RealtimeVoiceBlocker": {
      "description": "阻断实时语音会话的单个原因。\n\n只有 `realtime == true` 时该列表才为空；UI 只能按这些原因展示不可用状态，\n不得渲染开始/停止等伪控制。",
      "oneOf": [
        {
          "const": "providerRealtimeUnsupported",
          "description": "当前默认 provider 不是官方 OpenAI API-key 路由，没有可用的 Realtime wire。",
          "type": "string"
        },
        {
          "const": "providerKeyMissing",
          "description": "官方 OpenAI provider 已配置，但没有可解密使用的启用 API key。",
          "type": "string"
        },
        {
          "const": "realtimeModelUnconfigured",
          "description": "没有显式配置实时语音模型。",
          "type": "string"
        },
        {
          "const": "realtimeModelUnsupported",
          "description": "显式配置的模型不在本构建的实时语音 wire 支持集合内。",
          "type": "string"
        },
        {
          "const": "realtimeVoiceUnconfigured",
          "description": "没有显式配置实时语音音色。",
          "type": "string"
        },
        {
          "const": "realtimeVoiceUnsupported",
          "description": "显式配置的音色不受官方 Realtime API 支持。",
          "type": "string"
        },
        {
          "const": "realtimeTransportUnimplemented",
          "description": "宿主缺少浏览器 WebRTC / 麦克风 / SDP 会话路径。",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "imageGeneration": {
      "type": "boolean"
    },
    "namespaceTools": {
      "type": "boolean"
    },
    "realtime": {
      "description": "当前 provider 路由、配置与宿主是否已经具备端到端实时语音能力。\n\n`namespaceTools` 同属 Lime 在 Codex 形状上的扩展字段。该值为 `false`\n时，`realtimeBlockers` 给出具体缺失环节。",
      "type": "boolean"
    },
    "realtimeBlockers": {
      "items": {
        "$ref": "#/$defs/RealtimeVoiceBlocker"
      },
      "type": "array"
    },
    "realtimeModel": {
      "description": "显式配置的实时语音模型；未配置时为空。",
      "type": [
        "null",
        "string"
      ]
    },
    "realtimeModels": {
      "default": [],
      "description": "本构建可用的实时语音模型选项；provider 不可用时为空。",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "realtimeVoice": {
      "description": "显式配置的实时语音音色；未配置时为空。",
      "type": [
        "null",
        "string"
      ]
    },
    "realtimeVoices": {
      "default": [],
      "description": "官方 Realtime API 支持的音色选项；provider 不可用时为空。",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "webSearch": {
      "type": "boolean"
    }
  },
  "required": [
    "imageGeneration",
    "namespaceTools",
    "realtime",
    "realtimeBlockers",
    "webSearch"
  ],
  "title": "ModelProviderCapabilitiesReadResponse",
  "type": "object"
}
