{
  "$defs": {
    "RealtimeVoiceBlocker": {
      "description": "阻断实时语音会话的单个原因。\n\n只有 `realtime == true` 时该列表才为空；UI 只能按这些原因展示不可用状态，\n不得渲染开始/停止等伪控制。",
      "oneOf": [
        {
          "const": "providerRealtimeUnsupported",
          "description": "当前 provider 路由没有实时语音 wire 适配器。",
          "type": "string"
        },
        {
          "const": "realtimeTransportUnimplemented",
          "description": "App Server / 宿主还没有实时语音会话 owner，无法承载音频与转录事件。",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "imageGeneration": {
      "type": "boolean"
    },
    "namespaceTools": {
      "type": "boolean"
    },
    "realtime": {
      "description": "当前 provider 路由与 App Server 是否已经具备端到端实时语音能力。\n\n`namespaceTools` 同属 Lime 在 Codex 形状上的扩展字段。该值为 `false`\n时，`realtimeBlockers` 给出具体缺失环节。",
      "type": "boolean"
    },
    "realtimeBlockers": {
      "items": {
        "$ref": "#/$defs/RealtimeVoiceBlocker"
      },
      "type": "array"
    },
    "webSearch": {
      "type": "boolean"
    }
  },
  "required": [
    "imageGeneration",
    "namespaceTools",
    "realtime",
    "realtimeBlockers",
    "webSearch"
  ],
  "title": "ModelProviderCapabilitiesReadResponse",
  "type": "object"
}
