{
  "$defs": {
    "AppSummary": {
      "properties": {
        "category": {
          "type": [
            "null",
            "string"
          ]
        },
        "description": {
          "type": [
            "null",
            "string"
          ]
        },
        "id": {
          "type": "string"
        },
        "installUrl": {
          "type": [
            "null",
            "string"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "AppTemplateSummary": {
      "properties": {
        "canonicalConnectorId": {
          "type": [
            "null",
            "string"
          ]
        },
        "category": {
          "type": [
            "null",
            "string"
          ]
        },
        "description": {
          "type": [
            "null",
            "string"
          ]
        },
        "logoUrl": {
          "type": [
            "null",
            "string"
          ]
        },
        "logoUrlDark": {
          "type": [
            "null",
            "string"
          ]
        },
        "materializedAppIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/AppTemplateUnavailableReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "templateId": {
          "type": "string"
        }
      },
      "required": [
        "materializedAppIds",
        "name",
        "templateId"
      ],
      "type": "object"
    },
    "AppTemplateUnavailableReason": {
      "enum": [
        "NOT_CONFIGURED_FOR_WORKSPACE",
        "NO_ACTIVE_WORKSPACE"
      ],
      "type": "string"
    },
    "HookEventName": {
      "enum": [
        "interrupt",
        "permissionRequest",
        "postCompact",
        "postToolUse",
        "preCompact",
        "preToolUse",
        "sessionEnd",
        "sessionStart",
        "stop",
        "subagentStart",
        "subagentStop",
        "userPromptSubmit"
      ],
      "type": "string"
    },
    "MarketReleaseReference": {
      "additionalProperties": false,
      "description": "Immutable artifact identity, independent of the item's current publication.",
      "properties": {
        "archiveSha256": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "manifestSha256": {
          "type": "string"
        }
      },
      "required": [
        "archiveSha256",
        "id",
        "manifestSha256"
      ],
      "type": "object"
    },
    "PluginAuthPolicy": {
      "enum": [
        "ON_INSTALL",
        "ON_USE"
      ],
      "type": "string"
    },
    "PluginAvailability": {
      "enum": [
        "AVAILABLE",
        "DISABLED_BY_ADMIN"
      ],
      "type": "string"
    },
    "PluginDetail": {
      "properties": {
        "appTemplates": {
          "items": {
            "$ref": "#/$defs/AppTemplateSummary"
          },
          "type": "array"
        },
        "apps": {
          "items": {
            "$ref": "#/$defs/AppSummary"
          },
          "type": "array"
        },
        "description": {
          "type": [
            "null",
            "string"
          ]
        },
        "hooks": {
          "items": {
            "$ref": "#/$defs/PluginHookSummary"
          },
          "type": "array"
        },
        "marketplaceName": {
          "type": "string"
        },
        "marketplacePath": {
          "type": [
            "null",
            "string"
          ]
        },
        "mcpServers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "onboardingSkill": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkillSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The declared onboarding skill, when the plugin and visible skill are enabled."
        },
        "scheduledTasks": {
          "items": {
            "$ref": "#/$defs/ScheduledTaskSummary"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "skills": {
          "items": {
            "$ref": "#/$defs/SkillSummary"
          },
          "type": "array"
        },
        "summary": {
          "$ref": "#/$defs/PluginSummary"
        }
      },
      "required": [
        "appTemplates",
        "apps",
        "hooks",
        "marketplaceName",
        "mcpServers",
        "skills",
        "summary"
      ],
      "type": "object"
    },
    "PluginDisabledReason": {
      "enum": [
        "disabled_by_admin",
        "plan_not_eligible",
        "required_app_unavailable",
        "unknown"
      ],
      "type": "string"
    },
    "PluginHookSummary": {
      "properties": {
        "eventName": {
          "$ref": "#/$defs/HookEventName"
        },
        "key": {
          "type": "string"
        }
      },
      "required": [
        "eventName",
        "key"
      ],
      "type": "object"
    },
    "PluginInstallPolicy": {
      "enum": [
        "AVAILABLE",
        "INSTALLED_BY_DEFAULT",
        "NOT_AVAILABLE"
      ],
      "type": "string"
    },
    "PluginInstallPolicySource": {
      "enum": [
        "IMPLICIT_CANONICAL_APP",
        "WORKSPACE_SETTING"
      ],
      "type": "string"
    },
    "PluginInterface": {
      "properties": {
        "brandColor": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "capabilities": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "category": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "composerIcon": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "composerIconUrl": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "defaultPrompt": {
          "default": null,
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "developerName": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "displayName": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "logo": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "logoDark": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "logoUrl": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "logoUrlDark": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "longDescription": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "privacyPolicyUrl": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "screenshotUrls": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "screenshots": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "shortDescription": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "termsOfServiceUrl": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "websiteUrl": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        }
      },
      "type": "object"
    },
    "PluginSource": {
      "oneOf": [
        {
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "const": "local",
              "type": "string"
            }
          },
          "required": [
            "path",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "path": {
              "default": null,
              "type": [
                "null",
                "string"
              ]
            },
            "refName": {
              "default": null,
              "type": [
                "null",
                "string"
              ]
            },
            "sha": {
              "default": null,
              "type": [
                "null",
                "string"
              ]
            },
            "type": {
              "const": "git",
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ],
          "type": "object"
        },
        {
          "properties": {
            "package": {
              "type": "string"
            },
            "registry": {
              "default": null,
              "type": [
                "null",
                "string"
              ]
            },
            "type": {
              "const": "npm",
              "type": "string"
            },
            "version": {
              "default": null,
              "type": [
                "null",
                "string"
              ]
            }
          },
          "required": [
            "package",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "remote",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "PluginSummary": {
      "properties": {
        "authPolicy": {
          "$ref": "#/$defs/PluginAuthPolicy"
        },
        "availability": {
          "$ref": "#/$defs/PluginAvailability",
          "default": "AVAILABLE"
        },
        "disabledReason": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginDisabledReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "eligiblePlanTypes": {
          "default": null,
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "installPolicy": {
          "$ref": "#/$defs/PluginInstallPolicy"
        },
        "installPolicySource": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginInstallPolicySource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "installed": {
          "type": "boolean"
        },
        "installedAt": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "interface": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginInterface"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "keywords": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "localRelease": {
          "anyOf": [
            {
              "$ref": "#/$defs/MarketReleaseReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "localVersion": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "mustShowInstallationInterstitial": {
          "default": null,
          "type": [
            "boolean",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "remotePluginId": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "remoteRelease": {
          "anyOf": [
            {
              "$ref": "#/$defs/MarketReleaseReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "$ref": "#/$defs/PluginSource"
        },
        "version": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "authPolicy",
        "enabled",
        "id",
        "installPolicy",
        "installed",
        "name",
        "source"
      ],
      "type": "object"
    },
    "ScheduledTaskSchedule": {
      "oneOf": [
        {
          "properties": {
            "days": {
              "items": {
                "$ref": "#/$defs/ScheduledTaskWeekday"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "intervalHours": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "hourly",
              "type": "string"
            }
          },
          "required": [
            "intervalHours",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "time": {
              "type": "string"
            },
            "type": {
              "const": "daily",
              "type": "string"
            }
          },
          "required": [
            "time",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "time": {
              "type": "string"
            },
            "type": {
              "const": "weekdays",
              "type": "string"
            }
          },
          "required": [
            "time",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "days": {
              "items": {
                "$ref": "#/$defs/ScheduledTaskWeekday"
              },
              "type": "array"
            },
            "time": {
              "type": "string"
            },
            "type": {
              "const": "weekly",
              "type": "string"
            }
          },
          "required": [
            "days",
            "time",
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "ScheduledTaskSummary": {
      "properties": {
        "key": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "schedule": {
          "$ref": "#/$defs/ScheduledTaskSchedule"
        }
      },
      "required": [
        "key",
        "name",
        "prompt",
        "schedule"
      ],
      "type": "object"
    },
    "ScheduledTaskWeekday": {
      "enum": [
        "FR",
        "MO",
        "SA",
        "SU",
        "TH",
        "TU",
        "WE"
      ],
      "type": "string"
    },
    "SkillInterface": {
      "properties": {
        "brandColor": {
          "type": [
            "null",
            "string"
          ]
        },
        "defaultPrompt": {
          "type": [
            "null",
            "string"
          ]
        },
        "displayName": {
          "type": [
            "null",
            "string"
          ]
        },
        "iconLarge": {
          "type": [
            "null",
            "string"
          ]
        },
        "iconLargeUrl": {
          "type": [
            "null",
            "string"
          ]
        },
        "iconSmall": {
          "type": [
            "null",
            "string"
          ]
        },
        "iconSmallUrl": {
          "type": [
            "null",
            "string"
          ]
        },
        "shortDescription": {
          "type": [
            "null",
            "string"
          ]
        }
      },
      "type": "object"
    },
    "SkillSummary": {
      "properties": {
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "interface": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkillInterface"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": [
            "null",
            "string"
          ]
        },
        "shortDescription": {
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "description",
        "enabled",
        "name"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "plugin": {
      "$ref": "#/$defs/PluginDetail"
    }
  },
  "required": [
    "plugin"
  ],
  "title": "PluginReadResponse",
  "type": "object"
}
