{
  "$defs": {
    "PromptHistoryEntry": {
      "description": "Persistent prompt history entry. Rich composer state is intentionally not\npersisted here; attachments and placeholders remain session-local. Selected skill targets\nmay be encoded as links in text, using the same history codec as the composer.",
      "properties": {
        "offset": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "text": {
          "type": "string"
        },
        "threadId": {
          "type": "string"
        },
        "ts": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "offset",
        "text",
        "threadId",
        "ts"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "entry": {
      "$ref": "#/$defs/PromptHistoryEntry"
    },
    "entryCount": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "logId": {
      "type": "string"
    }
  },
  "required": [
    "entry",
    "entryCount",
    "logId"
  ],
  "title": "PromptHistoryAppendResponse",
  "type": "object"
}
