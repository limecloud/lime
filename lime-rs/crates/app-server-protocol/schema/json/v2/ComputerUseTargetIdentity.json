{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "appId": {
          "type": "string"
        },
        "processId": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "title": {
          "type": [
            "null",
            "string"
          ]
        },
        "type": {
          "const": "native",
          "type": "string"
        },
        "windowId": {
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "appId",
        "type"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "string"
        },
        "profileId": {
          "type": "string"
        },
        "tabId": {
          "type": "string"
        },
        "type": {
          "const": "chrome",
          "type": "string"
        },
        "url": {
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "origin",
        "profileId",
        "tabId",
        "type"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "type": {
          "const": "office",
          "type": "string"
        },
        "workbookId": {
          "type": "string"
        },
        "workbookName": {
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "host",
        "sessionId",
        "type",
        "workbookId"
      ],
      "type": "object"
    }
  ],
  "title": "ComputerUseTargetIdentity"
}
