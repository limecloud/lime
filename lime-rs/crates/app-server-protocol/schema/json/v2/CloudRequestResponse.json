{
  "$defs": {
    "Account": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "applicationId": {
              "type": "string"
            },
            "baseUrl": {
              "type": "string"
            },
            "clientId": {
              "type": "string"
            },
            "displayName": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "environment": {
              "type": "string"
            },
            "generation": {
              "type": "string"
            },
            "issuer": {
              "type": "string"
            },
            "resources": {
              "items": {
                "$ref": "#/$defs/CloudResourceCredential"
              },
              "type": "array"
            },
            "type": {
              "const": "cloud",
              "type": "string"
            },
            "userId": {
              "type": "string"
            }
          },
          "required": [
            "applicationId",
            "baseUrl",
            "clientId",
            "displayName",
            "email",
            "environment",
            "generation",
            "issuer",
            "resources",
            "type",
            "userId"
          ],
          "type": "object"
        }
      ]
    },
    "CloudCredentialStatus": {
      "enum": [
        "connected",
        "expired",
        "outcome_unknown",
        "refreshing",
        "verification_required"
      ],
      "type": "string"
    },
    "CloudOperationReference": {
      "properties": {
        "key": {
          "type": "string"
        },
        "recoveryPath": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "taskId": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "recoveryPath",
        "status",
        "taskId"
      ],
      "type": "object"
    },
    "CloudResource": {
      "enum": [
        "connections",
        "default",
        "market",
        "web"
      ],
      "type": "string"
    },
    "CloudResourceCredential": {
      "properties": {
        "audience": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string"
        },
        "resource": {
          "$ref": "#/$defs/CloudResource"
        },
        "scope": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CloudCredentialStatus"
        }
      },
      "required": [
        "audience",
        "expiresAt",
        "resource",
        "scope",
        "status"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "account": {
      "$ref": "#/$defs/Account"
    },
    "body": true,
    "operation": {
      "anyOf": [
        {
          "$ref": "#/$defs/CloudOperationReference"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "account",
    "body",
    "status"
  ],
  "title": "CloudRequestResponse",
  "type": "object"
}
