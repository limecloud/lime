{
  "$defs": {
    "ComputerUseAdapterKind": {
      "enum": [
        "chrome",
        "native",
        "office"
      ],
      "type": "string"
    },
    "ComputerUseCapability": {
      "enum": [
        "chart_read",
        "chart_write",
        "click",
        "dom_read",
        "download",
        "drag",
        "formula_read",
        "formula_write",
        "key",
        "navigate",
        "observe",
        "range_read",
        "range_write",
        "raw_cdp",
        "screenshot",
        "scroll",
        "sheet_read",
        "sheet_write",
        "table_read",
        "table_write",
        "type",
        "upload",
        "workbook_read",
        "workbook_write"
      ],
      "type": "string"
    },
    "ComputerUseGrantScope": {
      "enum": [
        "persistent",
        "session"
      ],
      "type": "string"
    },
    "ComputerUseTargetIdentity": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "appId": {
              "type": "string"
            },
            "processId": {
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "title": {
              "type": [
                "null",
                "string"
              ]
            },
            "type": {
              "const": "native",
              "type": "string"
            },
            "windowId": {
              "type": [
                "null",
                "string"
              ]
            }
          },
          "required": [
            "appId",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "origin": {
              "type": "string"
            },
            "profileId": {
              "type": "string"
            },
            "tabId": {
              "type": "string"
            },
            "type": {
              "const": "chrome",
              "type": "string"
            },
            "url": {
              "type": [
                "null",
                "string"
              ]
            }
          },
          "required": [
            "origin",
            "profileId",
            "tabId",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string"
            },
            "sessionId": {
              "type": "string"
            },
            "type": {
              "const": "office",
              "type": "string"
            },
            "workbookId": {
              "type": "string"
            },
            "workbookName": {
              "type": [
                "null",
                "string"
              ]
            }
          },
          "required": [
            "host",
            "sessionId",
            "type",
            "workbookId"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "adapter": {
      "$ref": "#/$defs/ComputerUseAdapterKind"
    },
    "capabilities": {
      "items": {
        "$ref": "#/$defs/ComputerUseCapability"
      },
      "type": "array"
    },
    "epoch": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/ComputerUseGrantScope"
    },
    "target": {
      "$ref": "#/$defs/ComputerUseTargetIdentity"
    }
  },
  "required": [
    "adapter",
    "capabilities",
    "epoch",
    "id",
    "scope",
    "target"
  ],
  "title": "ComputerUseGrant",
  "type": "object"
}
