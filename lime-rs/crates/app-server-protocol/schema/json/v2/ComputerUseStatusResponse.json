{
  "$defs": {
    "ComputerUseAdapterKind": {
      "enum": [
        "chrome",
        "native",
        "office"
      ],
      "type": "string"
    },
    "ComputerUseAdapterStatus": {
      "properties": {
        "adapter": {
          "$ref": "#/$defs/ComputerUseAdapterKind"
        },
        "capabilities": {
          "items": {
            "$ref": "#/$defs/ComputerUseCapability"
          },
          "type": "array"
        },
        "epoch": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "readiness": {
          "$ref": "#/$defs/ComputerUseReadiness"
        },
        "reason": {
          "type": [
            "null",
            "string"
          ]
        },
        "setupSteps": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/ComputerUseTargetIdentity"
          },
          "type": "array"
        }
      },
      "required": [
        "adapter",
        "epoch",
        "readiness"
      ],
      "type": "object"
    },
    "ComputerUseCapability": {
      "enum": [
        "chart_read",
        "chart_write",
        "click",
        "dom_read",
        "download",
        "drag",
        "formula_read",
        "formula_write",
        "key",
        "navigate",
        "observe",
        "range_read",
        "range_write",
        "raw_cdp",
        "screenshot",
        "scroll",
        "sheet_read",
        "sheet_write",
        "table_read",
        "table_write",
        "type",
        "upload",
        "workbook_read",
        "workbook_write"
      ],
      "type": "string"
    },
    "ComputerUseReadiness": {
      "enum": [
        "blocked",
        "busy",
        "connecting",
        "disabled",
        "disconnected",
        "not_installed",
        "permission_required",
        "ready",
        "unavailable",
        "update_required"
      ],
      "type": "string"
    },
    "ComputerUseTargetIdentity": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "appId": {
              "type": "string"
            },
            "processId": {
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "title": {
              "type": [
                "null",
                "string"
              ]
            },
            "type": {
              "const": "native",
              "type": "string"
            },
            "windowId": {
              "type": [
                "null",
                "string"
              ]
            }
          },
          "required": [
            "appId",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "origin": {
              "type": "string"
            },
            "profileId": {
              "type": "string"
            },
            "tabId": {
              "type": "string"
            },
            "type": {
              "const": "chrome",
              "type": "string"
            },
            "url": {
              "type": [
                "null",
                "string"
              ]
            }
          },
          "required": [
            "origin",
            "profileId",
            "tabId",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string"
            },
            "sessionId": {
              "type": "string"
            },
            "type": {
              "const": "office",
              "type": "string"
            },
            "workbookId": {
              "type": "string"
            },
            "workbookName": {
              "type": [
                "null",
                "string"
              ]
            }
          },
          "required": [
            "host",
            "sessionId",
            "type",
            "workbookId"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "adapters": {
      "items": {
        "$ref": "#/$defs/ComputerUseAdapterStatus"
      },
      "type": "array"
    },
    "epoch": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "adapters",
    "epoch"
  ],
  "title": "ComputerUseStatusResponse",
  "type": "object"
}
